# Peer Grading Tool — local DocPouch helper configuration.
# Copy to `.env` (in the repository root) and adjust. The helper scripts never
# hardcode credentials.

# Base URL of the local DocPouch (docker compose, port 3031).
DP_BASE=http://localhost:3031

# Super-admin used by docpouch-dev/setup-local.mjs.
DP_USER=admin
# REQUIRED for the helper scripts (matches ADMIN_INITIAL_PASSWORD in the
# docker-compose file).
DP_PASSWORD=admin

# Registration token for POST /oidc/reg (matches OIDC_REGISTRATION_TOKEN in
# the docker-compose file).
DP_OIDC_REGISTRATION_TOKEN=peer-grading-dev-token-123

# Public URL of the PGT frontend. Used as OIDC redirect target and in the TDD.
PGT_PUBLIC_URL=http://localhost:4200
