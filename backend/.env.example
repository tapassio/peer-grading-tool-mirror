DATABASE_URL="file:./dev.db"
# Three DIFFERENT random secrets, at least 32 characters each.
# Create each one with:  openssl rand -base64 48
# With PRODUCTION=true the server refuses to start with weak secrets.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_REGISTRATION_SECRET=""
SEND_GRID_KEY="SendGridKey"
SEND_GRID_SENDER_EMAIL='SendGridEmailAdress'
HOST="http://localhost:4200/"

# --- Deployment -------------------------------------------------------------
# Public URL of the app (used in e-mails). For the Toolchain host use
# https://tapassio.pantek.ch/tc/PeerGrading
# Sub-path the app is served under, e.g. /tc/PeerGrading (empty = root)
APP_BASE_PATH=""
# Comma separated list of allowed CORS origins.
# Empty = allow all in development, same-origin only in production.
CORS_ORIGINS=""
# Number of reverse proxies in front of the app (e.g. 1 behind nginx).
# Needed so that the rate limit sees the real client IP. Empty = none.
TRUST_PROXY=""
# Comma separated origins that may show the app in an iframe. Empty = none.
FRAME_ANCESTORS=""

# --- Authentication ---------------------------------------------------------
# "local" (development, e-mail/password) or "oidc" (DocPouch, production)
AUTH_MODE="local"
# DocPouch instance
DOCPOUCH_URL="http://localhost:3033"
DOCPOUCH_OIDC_ISSUER="http://localhost:3033/oidc"
# Client id from the DocPouch OIDC dynamic client registration
DOCPOUCH_CLIENT_ID=""
DOCPOUCH_OIDC_SCOPE="openid profile email offline_access"
DOCPOUCH_TIMEOUT_MS="5000"
# Public URLs of the PGT itself. The localized frontend derives the effective
# OIDC redirect/post-logout URIs from its own <base href> (language prefix);
# these values are fallbacks only. Register every language variant with DocPouch.
PGT_PUBLIC_URL="http://localhost:4200"
PGT_OIDC_REDIRECT_URI="http://localhost:4200/en/auth/callback"
PGT_POST_LOGOUT_REDIRECT_URI="http://localhost:4200/en/"
# PGT token lifetimes (DocPouch is only contacted during login/exchange).
# OIDC: when the access token expires the frontend exchanges a fresh DocPouch
# token, so blocked DocPouch accounts lose access after this time at the latest.
PGT_ACCESS_TOKEN_TTL="1h"
PGT_REFRESH_TOKEN_TTL="2d"
# Max. DocPouch requests (whoami) per 15 minutes for the whole PGT server.
# DocPouch allows 100 GET requests / 15 min per IP; keep a reserve.
DOCPOUCH_REQUEST_BUDGET="60"
# Optional, recommended for production: id of the DocPouch structure for
# published results. Has priority over the Tool Details Document.
PGT_RESULT_STRUCTURE_ID=""
