{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "npx ng",
    "start": "npx ng serve",
    "build": "npx ng build",
    "watch": "npx ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ],
    "transformIgnorePatterns": [
      "  '/node_modules/(?!d3-(interpolate|color))'"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/test.ts"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "docpouch-client": "^1.3.1",
    "exceljs": "^4.3.0",
    "file-saver": "^2.0.5",
    "html-to-pdfmake": "^2.4.9",
    "jspdf": "^2.5.1",
    "pdfmake": "^0.2.6",
    "rxjs": "~7.8.0",
    "stream": "^0.0.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "~22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/localize": "^22.2.6",
    "@types/file-saver": "^2.0.5",
    "@types/html-to-pdfmake": "^2.1.1",
    "@types/jest": "^30.0.0",
    "@types/pdfmake": "^0.2.2",
    "@types/string-similarity": "^4.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "ng-extract-i18n-merge": "^3.5.0",
    "typescript": "^6.0.3",
    "jsdom": "^26.1.0",
    "jest-environment-jsdom": "^30.5.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
